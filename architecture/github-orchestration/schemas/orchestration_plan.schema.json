{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harmonic-ops-machine/lifeops-multi-agent-sim/architecture/github-orchestration/schemas/orchestration_plan.schema.json",
  "title": "OrchestrationPlan",
  "description": "Locked, DAG-validated multi-agent orchestration plan with disjoint file ownership and umbrella branch targeting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tracker_id",
    "umbrella_branch",
    "source_issue",
    "discovery_sha256",
    "tasks"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "GH-ORCHESTRATION-PLAN-v1"
    },
    "tracker_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{6,128}$",
      "description": "Shared correlation identifier persisted across Git checkpoints, workflow artifacts, and telemetry spans."
    },
    "umbrella_branch": {
      "type": "string",
      "pattern": "^agent-work/[A-Za-z0-9._/-]+$",
      "description": "Non-protected integration branch receiving validated worker merges prior to a single consolidated main PR."
    },
    "source_issue": {
      "type": "integer",
      "minimum": 1
    },
    "discovery_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at_utc": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/SubTask"
      }
    }
  },
  "$defs": {
    "SubTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "issue_number",
        "owned_paths",
        "depends_on",
        "acceptance_criteria"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "owned_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Non-overlapping repository path prefixes or globs exclusively leased to this worker."
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "model_tier": {
          "type": "string",
          "enum": [
            "fast-discovery",
            "frontier-planner",
            "code-worker",
            "judge-review"
          ],
          "default": "code-worker"
        },
        "token_budget": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 2000000,
          "default": 120000
        },
        "heartbeat_timeout_sec": {
          "type": "integer",
          "minimum": 60,
          "maximum": 7200,
          "default": 900
        }
      }
    }
  }
}
